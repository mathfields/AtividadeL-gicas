programa {
  funcao inicio() {
    logico confirma
    
    escreva("Está chovendo Sim/não?:")
    leia (confirma)

    se (confirma == verdadeiro){
      escreva ("Não sai de casa, você pode pegar um resfriado, apenas com guarda chuva!")
    }

    senao{
      escreva ("O céu está ótimo para sair hoje")

    }

  
  }
}
