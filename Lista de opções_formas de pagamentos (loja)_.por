programa {
  funcao inicio() {

    logico  debito
    logico  credito
    logico  pix
    logico  dinheiro
    cadeia  menu
    escreva("Escolha uma opção\n ============= 1.debito\n 2.credito\n 3.pix\n 4.dinheiro:")
    leia(menu)

    se (menu == 1){
      menu == debito 
      escreva("Você selecionou a opção de debito, deseja proseguir?")

    }
    senao (menu ==2){

     escreva("Você selecionou a opção de credito, deseja proseguir?")}

    senao (menu ==3)

     escreva("Você selecionou a opção de credito, deseja proseguir?")
    

     
  }
}
