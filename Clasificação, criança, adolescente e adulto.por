programa {
  funcao inicio() {
    inteiro idade
    escreva ("Digite a idade para classificar:")
    leia (idade)

    se (idade <=12){
      escreva("Nessa idade se é criança")
    }

     se (idade >=13 e idade <=17){
      escreva("Nessa idade se é adolescente")
    }
    se (idade >=18){
      escreva("Nessa idade se é adulto")
    }


  }
}
